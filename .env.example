# Copy to .env and fill in. Never commit real values. Every variable the server reads is listed here
# (server/tests/config.test.ts fails if one is missing); commented-out lines show the default.

# development | test | production. A deployed build (npm run build && npm start) refuses to start unless this is
# explicitly "production" (risk S1). The dev server (npm run dev) defaults to development.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# The public URL users open; always accepted as a same-origin Origin (survives a proxy rewriting Host).
APP_BASE_URL=http://localhost:8080

# PostgreSQL 15 or later, with the pg_trgm and pgcrypto extensions
DATABASE_URL=postgres://localhost/kyc_dev

# >= 16 random chars; REQUIRED in production (signs anonymous cookies; share links use a key derived from it).
# Generate: openssl rand -hex 32
COOKIE_SECRET=
# true only behind a reverse proxy you control (honours X-Forwarded-For for per-IP rate limits)
TRUST_PROXY=false
# defaults to true in production; set false only for plain-http deployments
# COOKIE_SECURE=true

# Accounts: sessions expire absolutely after this many days. Register/sign-in attempts per IP per hour.
# SESSION_TTL_DAYS=30
# RATE_AUTH_PER_HOUR=20

# Exact origins allowed to call the API cross-origin (the desktop shell, P4.1), comma-separated. Tauri serves the app
# from tauri://localhost (macOS, Linux) and http://tauri.localhost (Windows): list both for desktop users. No
# wildcards. Such clients must use bearer tokens; cookies are ignored. Empty (default): no cross-origin access at all.
CORS_ALLOWED_ORIGINS=

# AI provider. LLM_PROVIDER:
# - "fake":      deterministic test provider (no API key, no network; tests, CI and offline demos)
# - "anthropic": the Anthropic API (requires ANTHROPIC_API_KEY)
# - "groq":      the Groq API (requires GROQ_API_KEY and explicit MODEL_FAST / MODEL_STRONG; not on the MVP path)
# Only short code snippets selected by the user are sent, never the whole repository. What the provider does with
# them is governed by that provider's terms, not by this file.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# GROQ_API_BASE=https://api.groq.com/openai/v1

# Models for the two tiers, named as the selected provider names them. Defaults: claude-haiku-5-5 / claude-sonnet-5-5.
# With LLM_PROVIDER=groq both must be set (there are no Groq defaults: Groq retires models; check
# https://console.groq.com/docs/deprecations before choosing).
# MODEL_FAST=claude-haiku-5-5
# MODEL_STRONG=claude-sonnet-5-5

# Prices in USD per million tokens. The defaults are PLACEHOLDERS for development; production with a real provider
# refuses to start until all four are set from the provider's current price list. They drive the spend caps below.
MODEL_FAST_INPUT_USD_PER_MTOK=
MODEL_FAST_OUTPUT_USD_PER_MTOK=
MODEL_STRONG_INPUT_USD_PER_MTOK=
MODEL_STRONG_OUTPUT_USD_PER_MTOK=
# AI budget (P4.3). Every model call reserves its worst-case cost first, so concurrent requests cannot exceed:
# the global cap per day, each user's share of it (must be below the global cap in production), and each user's
# number of model calls per day.
DAILY_SPEND_CAP_USD=5
# AI_USER_DAILY_BUDGET_USD=0.5
# AI_USER_DAILY_REQUESTS=300
AI_TIMEOUT_MS=30000

# Optional but recommended: fine-grained, read-only, public-data GitHub token (raises the API limit from 60/h to 5000/h).
# Without it, imports use codeload.github.com directly and cannot pre-check repo size/visibility.
GITHUB_TOKEN=
# GITHUB_API_BASE=https://api.github.com
# GITHUB_CODELOAD_BASE=https://codeload.github.com

RETENTION_DAYS=7

# Import limits
MAX_TARBALL_BYTES=52428800
# MAX_REPORTED_REPO_KB=204800
MAX_ANALYSABLE_FILES=1500
MAX_ANALYSABLE_FILE_BYTES=307200
# MAX_VIEWABLE_FILE_BYTES=1048576
# MAX_TOTAL_TEXT_BYTES=31457280
# MAX_TOTAL_ENTRIES=20000
IMPORT_TIMEOUT_MS=120000
IMPORT_CONCURRENCY=2

# Analysis runs in a memory-capped worker thread. "auto" falls back to in-process analysis when no compiled worker
# exists (dev); production always uses "worker" and refuses "inline" (risk S6).
# ANALYSIS_MODE=auto
# ANALYSIS_WORKER_PATH=
# ANALYSIS_MAX_MEMORY_MB=2048

# Rate limits per user per hour
# RATE_LIMIT_DISABLED=false
RATE_IMPORTS_PER_HOUR=5
RATE_EXPLANATIONS_PER_HOUR=60
RATE_FOLLOWUPS_PER_HOUR=120

# Where the built web client lives (default: client/dist under the working directory), and the reported version.
# STATIC_DIR=
# APP_VERSION=1.0.0

# Operations (P4.2). DEPLOY_ENVIRONMENT names this deployment in logs and alerts (lowercase, e.g. staging).
# DEPLOY_ENVIRONMENT=local
# Alert when ALERT_5XX_THRESHOLD server errors, or ALERT_JOB_FAILURE_THRESHOLD failed imports, happen within
# ALERT_WINDOW_MINUTES. Alerts are logged at error level (event "alert"); with ALERT_WEBHOOK_URL (https; e.g. a Slack
# incoming webhook) they are also POSTed there. The webhook URL is a secret: set it in the platform's secret store.
# ALERT_WEBHOOK_URL=
# ALERT_WINDOW_MINUTES=5
# ALERT_5XX_THRESHOLD=10
# ALERT_JOB_FAILURE_THRESHOLD=3

# ---- Web client (build time, read by Vite from client/.env* or the environment; PUBLIC: compiled into the bundle,
# so never put a secret in a VITE_ variable). Empty: the API is on the same origin as the page.
# VITE_API_BASE_URL=
