# Copy to .env and fill in. Never commit real values. Every variable the server reads is listed here
# (server/tests/config.test.ts fails if one is missing); commented-out lines show the default.

# development | test | production. A deployed build (npm run build && npm start) refuses to start unless this is
# explicitly "production" (risk S1). The dev server (npm run dev) defaults to development.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# The public URL users open; always accepted as a same-origin Origin (survives a proxy rewriting Host).
APP_BASE_URL=http://localhost:8080

# PostgreSQL 15 or later, with the pg_trgm and pgcrypto extensions
DATABASE_URL=postgres://localhost/kyc_dev

# >= 16 random chars; REQUIRED in production (signs anonymous cookies; share links use a key derived from it).
# Generate: openssl rand -hex 32
COOKIE_SECRET=
# true only behind a reverse proxy you control (honours X-Forwarded-For for per-IP rate limits)
TRUST_PROXY=false
# defaults to true in production; set false only for plain-http deployments
# COOKIE_SECURE=true

# Accounts: sessions expire absolutely after this many days. Register/sign-in attempts per IP per hour.
# SESSION_TTL_DAYS=30
# RATE_AUTH_PER_HOUR=20

# Exact origins allowed to call the API cross-origin (a future desktop shell), comma-separated, e.g.
# tauri://localhost,http://tauri.localhost . No wildcards. Such clients must use bearer tokens; cookies are ignored.
# Empty (default): no cross-origin access at all.
CORS_ALLOWED_ORIGINS=

# AI. Supported LLM_PROVIDER options:
# - "fake" : Deterministic mock provider (no API key needed, offline demo & tests)
# - "groq" : High-speed Groq API (requires GROQ_API_KEY)
# - "anthropic": Claude API (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=fake

# Groq configuration (when LLM_PROVIDER=groq)
GROQ_API_KEY=
# GROQ_API_BASE=https://api.groq.com/openai/v1
# Default models for Groq if not set: MODEL_FAST=llama-3.1-8b-instant, MODEL_STRONG=llama-3.3-70b-versatile

# Anthropic configuration (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
MODEL_FAST=claude-3-5-haiku-20241022
MODEL_STRONG=claude-3-5-sonnet-20241022

# USD per million tokens. Check provider's pricing page; these drive the daily spend cap.
MODEL_FAST_INPUT_USD_PER_MTOK=0.1
MODEL_FAST_OUTPUT_USD_PER_MTOK=0.5
MODEL_STRONG_INPUT_USD_PER_MTOK=2
MODEL_STRONG_OUTPUT_USD_PER_MTOK=10
DAILY_SPEND_CAP_USD=5
AI_TIMEOUT_MS=30000

# Optional but recommended: fine-grained, read-only, public-data GitHub token (raises the API limit from 60/h to 5000/h).
# Without it, imports use codeload.github.com directly and cannot pre-check repo size/visibility.
GITHUB_TOKEN=
# GITHUB_API_BASE=https://api.github.com
# GITHUB_CODELOAD_BASE=https://codeload.github.com

RETENTION_DAYS=7

# Import limits
MAX_TARBALL_BYTES=52428800
# MAX_REPORTED_REPO_KB=204800
MAX_ANALYSABLE_FILES=1500
MAX_ANALYSABLE_FILE_BYTES=307200
# MAX_VIEWABLE_FILE_BYTES=1048576
# MAX_TOTAL_TEXT_BYTES=31457280
# MAX_TOTAL_ENTRIES=20000
IMPORT_TIMEOUT_MS=120000
IMPORT_CONCURRENCY=2

# Analysis runs in a memory-capped worker thread. "auto" falls back to in-process analysis when no compiled worker
# exists (dev); production always uses "worker" and refuses "inline" (risk S6).
# ANALYSIS_MODE=auto
# ANALYSIS_WORKER_PATH=
# ANALYSIS_MAX_MEMORY_MB=2048

# Rate limits per user per hour
# RATE_LIMIT_DISABLED=false
RATE_IMPORTS_PER_HOUR=5
RATE_EXPLANATIONS_PER_HOUR=60
RATE_FOLLOWUPS_PER_HOUR=120

# Where the built web client lives (default: client/dist under the working directory), and the reported version.
# STATIC_DIR=
# APP_VERSION=1.0.0

# ---- Web client (build time, read by Vite from client/.env* or the environment; PUBLIC: compiled into the bundle,
# so never put a secret in a VITE_ variable). Empty: the API is on the same origin as the page.
# VITE_API_BASE_URL=
