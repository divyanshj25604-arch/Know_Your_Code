# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
APP_BASE_URL=http://localhost:8080

# PostgreSQL (needs the pg_trgm and pgcrypto extensions)
DATABASE_URL=postgres://localhost/kyc_dev

# >= 16 random chars; REQUIRED in production. Generate: openssl rand -hex 32
COOKIE_SECRET=

# AI. LLM_PROVIDER=anthropic uses the Claude API; "fake" is a deterministic provider for tests only.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5
# USD per million tokens. Check the provider's pricing page; these drive the daily spend cap.
MODEL_FAST_INPUT_USD_PER_MTOK=1
MODEL_FAST_OUTPUT_USD_PER_MTOK=5
MODEL_STRONG_INPUT_USD_PER_MTOK=3
MODEL_STRONG_OUTPUT_USD_PER_MTOK=15
DAILY_SPEND_CAP_USD=5
AI_TIMEOUT_MS=30000

# Optional but recommended: fine-grained, read-only, public-data GitHub token (raises the API limit from 60/h to 5000/h).
# Without it, imports use codeload.github.com directly and cannot pre-check repo size/visibility.
GITHUB_TOKEN=

RETENTION_DAYS=7

# Import limits (defaults match docs/08 §3)
MAX_TARBALL_BYTES=52428800
MAX_ANALYSABLE_FILES=1500
MAX_ANALYSABLE_FILE_BYTES=307200
IMPORT_TIMEOUT_MS=120000
IMPORT_CONCURRENCY=2

# Rate limits per owner per hour
RATE_IMPORTS_PER_HOUR=5
RATE_EXPLANATIONS_PER_HOUR=60
RATE_FOLLOWUPS_PER_HOUR=120
