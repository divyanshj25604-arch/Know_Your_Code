{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Know Your Code",
  "version": "1.0.0",
  "identifier": "app.knowyourcode.desktop",
  "build": {
    "frontendDist": "../../client/dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev -w @kyc/client", "cwd": "..", "wait": false },
    "beforeBuildCommand": { "script": "npm run build:desktop -w @kyc/client", "cwd": ".." }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Know Your Code",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "Education",
    "shortDescription": "Learn your own codebase",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
