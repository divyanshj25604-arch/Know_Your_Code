{
  "name": "@kyc/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Know Your Code desktop shell (Tauri): the web client in a native window, connected to the cloud API.",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "build": "node scripts/tauri.mjs build",
    "build:debug": "node scripts/tauri.mjs build --debug",
    "test": "node --test tests/",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
